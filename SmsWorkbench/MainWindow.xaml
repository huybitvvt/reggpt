<ui:FluentWindow x:Class="SmsWorkbench.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:SmsWorkbench"
                 xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                 Title="GPT Register Tool"
                 Width="1360" Height="860" MinWidth="1220" MinHeight="720"
                 WindowStartupLocation="CenterScreen"
                 Background="{DynamicResource AppBg}"
                 FontFamily="Segoe UI, Microsoft YaHei UI"
                 FontSize="13"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
  <ui:FluentWindow.Resources>
    <local:StatusSeverityConverter x:Key="StatusSeverityConverter"/>
    <local:RtDisplayConverter x:Key="RtDisplayConverter"/>

    <Style x:Key="PaymentMethodBadge" TargetType="Border">
      <Setter Property="Height" Value="22"/>
      <Setter Property="MinWidth" Value="42"/>
      <Setter Property="CornerRadius" Value="11"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Background" Value="#334155"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding}" Value="Trial · 0 đ">
          <Setter Property="Background" Value="#168A3A"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Trial: 0 đ">
          <Setter Property="Background" Value="#168A3A"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Trial · 0$">
          <Setter Property="Background" Value="#168A3A"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Card">
          <Setter Property="Background" Value="#6758E8"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Apple Pay">
          <Setter Property="Background" Value="#05070A"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Google Pay">
          <Setter Property="Background" Value="#F8FAFC"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="MoMo">
          <Setter Property="Background" Value="#C01886"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="PayPal">
          <Setter Property="Background" Value="#0079C1"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="GCash">
          <Setter Property="Background" Value="#007DFE"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="GoPay">
          <Setter Property="Background" Value="#00AED6"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Kakao Pay">
          <Setter Property="Background" Value="#FFCD00"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PaymentMethodBadgeText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding}" Value="Google Pay">
          <Setter Property="Foreground" Value="#1F2937"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Kakao Pay">
          <Setter Property="Foreground" Value="#1F2937"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="AccountFilterChipStyle" TargetType="ToggleButton">
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinWidth" Value="54"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
      <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="ChipChrome"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="17">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ChipChrome" Property="Background" Value="{DynamicResource PanelHover}"/>
                <Setter TargetName="ChipChrome" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter TargetName="ChipChrome" Property="Background" Value="{DynamicResource AccentGreen}"/>
                <Setter TargetName="ChipChrome" Property="BorderBrush" Value="{DynamicResource AccentGreen}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SidebarNavButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Background" Value="{DynamicResource SidebarButtonBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PanelHover}"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PanelHover}"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SidebarPaneBorderStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SidebarBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="8"/>
    </Style>
    <Style x:Key="SidebarBrandLogoStyle" TargetType="Border">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Background" Value="{DynamicResource SidebarBg}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SidebarBrandTextPanelStyle" TargetType="StackPanel">
      <Setter Property="Margin" Value="10,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SidebarToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="10,0,0,0"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    CornerRadius="4">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PanelHover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PanelHover}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
          <Setter Property="Margin" Value="0,0,9,0"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SidebarScrollBarStyle" TargetType="{x:Type ScrollBar}">
      <Setter Property="Width" Value="0"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="Visibility" Value="Collapsed"/>
    </Style>
    <Style x:Key="SidebarLabelStyle" TargetType="TextBlock">
      <Setter Property="Margin" Value="10,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SidebarSectionHeaderStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="13"/>
      <Setter Property="Margin" Value="4,12,0,5"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
      <Setter Property="TextAlignment" Value="Left"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
          <Setter Property="Margin" Value="4,12,4,5"/>
          <Setter Property="HorizontalAlignment" Value="Stretch"/>
          <Setter Property="TextAlignment" Value="Left"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="AccountContextMenuStyle" TargetType="ContextMenu">
      <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="5"/>
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
      <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border x:Name="MenuChrome"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4"
                    SnapsToDevicePixels="True">
              <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AccountContextMenuItemStyle" TargetType="MenuItem">
      <Setter Property="MinWidth" Value="232"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
      <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="ItemChrome"
                    Height="{TemplateBinding Height}"
                    Background="Transparent"
                    Padding="8,0,12,0"
                    SnapsToDevicePixels="True">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="20"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="IconPresenter"
                                  Grid.Column="0"
                                  ContentSource="Icon"
                                  Width="16" Height="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  SnapsToDevicePixels="True"/>
                <TextBlock x:Name="HeaderText"
                           Grid.Column="2"
                           Text="{TemplateBinding Header}"
                           FontFamily="{TemplateBinding FontFamily}"
                           FontSize="{TemplateBinding FontSize}"
                           FontWeight="{TemplateBinding FontWeight}"
                           Foreground="{TemplateBinding Foreground}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           SnapsToDevicePixels="True"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource PanelHover}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ItemChrome" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </ui:FluentWindow.Resources>
      <Grid Background="{DynamicResource AppBg}">
        <Grid.RowDefinitions>
          <RowDefinition Height="48"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

      <!-- Custom TitleBar with SVG icon buttons -->
      <Grid Grid.Row="0" Height="48" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- App title (left side, optional) -->
        <TextBlock Grid.Column="0"
                   VerticalAlignment="Center"
                   Margin="16,0,0,0"
                   FontSize="12"
                   Foreground="{DynamicResource TextMuted}"
                   Text="GRT"/>

        <!-- Window control buttons -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
          <!-- Minimize button -->
          <Button x:Name="MinimizeButton"
                  Width="46" Height="32"
                  WindowChrome.IsHitTestVisibleInChrome="True"
                  Click="MinimizeButton_Click"
                  ToolTip="Thu nhỏ"
                  BorderThickness="0" Padding="0"
                  Background="Transparent">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="BtnBg" Background="Transparent">
                  <Path Width="12" Height="1" Stretch="Uniform"
                        Data="M 0,0.5 L 12,0.5"
                        Stroke="{DynamicResource TextSub}"
                        StrokeThickness="1.5"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="BtnBg" Property="Background" Value="{DynamicResource PanelHover}"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>

          <!-- Maximize/Restore button -->
          <Button x:Name="MaximizeButton"
                  Width="46" Height="32"
                  WindowChrome.IsHitTestVisibleInChrome="True"
                  Click="MaximizeButton_Click"
                  ToolTip="Phóng to"
                  BorderThickness="0" Padding="0"
                  Background="Transparent">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="BtnBg" Background="Transparent">
                  <Path x:Name="MaxIcon" Width="12" Height="12" Stretch="Uniform"
                        Data="M 1,3 L 1,1 L 9,1 L 9,3 M 1,1 L 1,9 L 9,9 L 9,1"
                        Stroke="{DynamicResource TextSub}"
                        StrokeThickness="1.2"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="BtnBg" Property="Background" Value="{DynamicResource PanelHover}"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>

          <!-- Close button -->
          <Button x:Name="CloseButton"
                  Width="46" Height="32"
                  WindowChrome.IsHitTestVisibleInChrome="True"
                  Click="CloseButton_Click"
                  ToolTip="Đóng"
                  BorderThickness="0" Padding="0"
                  Background="Transparent">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="BtnBg" Background="Transparent">
                  <Path x:Name="CloseIcon" Width="10" Height="10" Stretch="Uniform"
                        Data="M 0,0 L 10,10 M 10,0 L 0,10"
                        Stroke="{DynamicResource TextSub}"
                        StrokeThickness="1.5"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="BtnBg" Property="Background" Value="{DynamicResource Danger}"/>
                    <Setter TargetName="CloseIcon" Property="Stroke" Value="#FFFFFF"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="SidebarColumn" Width="248"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid x:Name="SidebarHost" Grid.Column="0" Margin="10,0,10,10" ClipToBounds="True" HorizontalAlignment="Stretch">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Border Height="58"
                  Margin="0,0,0,10"
                  Style="{StaticResource SidebarPaneBorderStyle}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource SidebarBrandLogoStyle}">
                <Image Source="Assets/app-icon.ico" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" Style="{StaticResource SidebarBrandTextPanelStyle}" Margin="10,0,8,0">
                <TextBlock x:Name="SidebarBrandTitle"
                           Text="GPT Register Tool"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <Button x:Name="SidebarToggleButton"
                      Grid.Column="2"
                      Style="{StaticResource SidebarToggleButtonStyle}"
                      ToolTip="Thu gọn thanh bên"
                      Click="ToggleSidebar_Click">
                <Path Width="16"
                      Height="16"
                      Stretch="Uniform"
                      Data="{Binding SidebarToggleGeometry}"
                      Stroke="{DynamicResource TextSub}"
                      StrokeThickness="1.25"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Fill="Transparent"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
              </Button>
            </Grid>
          </Border>

          <Border Grid.Row="1"
                  Style="{StaticResource SidebarPaneBorderStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
              <ScrollViewer.Resources>
                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SidebarScrollBarStyle}"/>
              </ScrollViewer.Resources>
              <StackPanel>
                <TextBlock Text="Thao tác nhanh" Style="{StaticResource SidebarSectionHeaderStyle}"/>
                <Button Style="{StaticResource SidebarNavButtonStyle}" Click="OneClickRegister_Click">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="4" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" VerticalAlignment="Center">
                      <Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Data="M16 16v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M9 8a4 4 0 1 0 0-8 4 4 0 0 0 0 8 M22 16v-1 M19 13h6"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="Đăng ký nhanh" Style="{StaticResource SidebarLabelStyle}" FontSize="15" Foreground="{DynamicResource TextMain}"/>
                  </Grid>
                </Button>
                <Button Style="{StaticResource SidebarNavButtonStyle}" Click="OneClickSms_Click">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="4" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" VerticalAlignment="Center">
                      <Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Data="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="Nhận mã nhanh" Style="{StaticResource SidebarLabelStyle}" FontSize="15" Foreground="{DynamicResource TextMain}"/>
                  </Grid>
                </Button>
                <Button Style="{StaticResource SidebarNavButtonStyle}" Click="OneClickScan_Click">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="4" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" VerticalAlignment="Center">
                      <Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Data="M3 3v18h18 M7 14l4-4 4 4 5-5"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="Kiểm tra sống tài khoản" Style="{StaticResource SidebarLabelStyle}" FontSize="15" Foreground="{DynamicResource TextMain}"/>
                  </Grid>
                </Button>
                <Button Style="{StaticResource SidebarNavButtonStyle}" Click="CheckPromotion_Click">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="4" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" VerticalAlignment="Center">
                      <Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Data="M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7 M15 3h6v6 M10 14L21 3"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="Kiểm tra ưu đãi" Style="{StaticResource SidebarLabelStyle}" FontSize="15" Foreground="{DynamicResource TextMain}"/>
                  </Grid>
                </Button>

                <TextBlock Text="Quản lý thanh toán" Style="{StaticResource SidebarSectionHeaderStyle}"/>
                <Button Style="{StaticResource SidebarNavButtonStyle}" Click="OpenPayPalLink_Click">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="4" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" VerticalAlignment="Center">
                      <Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Data="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71 M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="Mở link thanh toán" Style="{StaticResource SidebarLabelStyle}" FontSize="15" Foreground="{DynamicResource TextMain}"/>
                  </Grid>
                </Button>
                <Button x:Name="BatchPaymentButton" AutomationProperties.Name="Thanh toán giao thức hàng loạt" Style="{StaticResource SidebarNavButtonStyle}" Click="BatchProtocolPayment_Click">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="4" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" VerticalAlignment="Center">
                      <Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"

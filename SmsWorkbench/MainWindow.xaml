                  <MenuItem Header="Sao chép địa chỉ email" Click="CtxCopyEmail_Click" Style="{StaticResource AccountContextMenuItemStyle}">
                    <MenuItem.Icon>
                      <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                            Data="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71 M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Sao chép AT" Click="CtxCopyAccessToken_Click" Style="{StaticResource AccountContextMenuItemStyle}">
                    <MenuItem.Icon>
                      <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                            Data="M15 7a5 5 0 1 0-4.9 6H13l2 2 2-2 2 2 3-3-4-4h-3z"/>
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Sao chép link thanh toán" Click="CtxCopyPayPal_Click" Style="{StaticResource AccountContextMenuItemStyle}">
                    <MenuItem.Icon>
                      <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                            Data="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71 M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Mở link thanh toán" Click="CtxOpenPayPal_Click" Style="{StaticResource AccountContextMenuItemStyle}">
                    <MenuItem.Icon>
                      <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                            Data="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6 M15 3h6v6 M10 14L21 3"/>
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Thanh toán giao thức hàng loạt" Click="CtxBatchProtocolPayment_Click" Style="{StaticResource AccountContextMenuItemStyle}">
                    <MenuItem.Icon>
                      <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                            Data="M4 5h16 M4 12h16 M4 19h16 M8 3v4 M8 10v4 M8 17v4"/>
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Đổi email hàng loạt" Click="CtxChangeEmail_Click" Style="{StaticResource AccountContextMenuItemStyle}">
                    <MenuItem.Icon>
                      <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" Fill="Transparent" Data="M4 7h11m0 0-3-3m3 3-3 3M20 17H9m0 0 3-3m-3 3 3 3"/>
                    </MenuItem.Icon>
                  </MenuItem>
                  <Separator/>
                  <MenuItem Header="Kiểm tra tài khoản hiện tại" Click="CtxCheckAccountAlive_Click" Style="{StaticResource AccountContextMenuItemStyle}">
                    <MenuItem.Icon>
                      <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                            Data="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8 M21 3v5h-5"/>
                    </MenuItem.Icon>
                  </MenuItem>
                  <Separator/>
                  <MenuItem Header="Mở file nguồn Session" Click="CtxOpenSource_Click" Style="{StaticResource AccountContextMenuItemStyle}">
                    <MenuItem.Icon>
                      <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                            Data="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
                    </MenuItem.Icon>
                  </MenuItem>
                </ContextMenu>
              </DataGrid.ContextMenu>
              <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Chọn" Binding="{Binding IsChecked}" Width="60"/>
                <DataGridTextColumn Header="Thời gian tạo" Binding="{Binding CreatedAt}" Width="155" IsReadOnly="True"/>
                <DataGridTextColumn Header="Thời gian cập nhật" Binding="{Binding CompletedAt}" Width="155" IsReadOnly="True"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Identifier}" Width="260" IsReadOnly="True"/>
                <DataGridTextColumn Header="Loại tài khoản" Binding="{Binding AccountPlanType}" Width="92" IsReadOnly="True"/>
                <DataGridTextColumn Header="Vùng đăng ký" Binding="{Binding RegistrationCountry}" Width="64" IsReadOnly="True"/>
                <DataGridTextColumn Header="Loại" Binding="{Binding AccountType}" Width="120" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Trạng thái" Width="96" IsReadOnly="True" SortMemberPath="Status" CanUserSort="True">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource StatusBadge}" Tag="{Binding Status, Converter={StaticResource StatusSeverityConverter}}">
                        <TextBlock Style="{StaticResource StatusBadgeText}" Text="{Binding Status}" TextTrimming="CharacterEllipsis"/>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="AT" Width="96" IsReadOnly="True" SortMemberPath="AccessTokenStatus" CanUserSort="True">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource StatusBadge}" Tag="{Binding AccessTokenStatus, Converter={StaticResource StatusSeverityConverter}}">
                        <TextBlock Style="{StaticResource StatusBadgeText}" Text="{Binding AccessTokenStatus}" TextTrimming="CharacterEllipsis"/>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="RT" Width="96" IsReadOnly="True">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource StatusBadge}" Tag="{Binding RefreshTokenStatus, Converter={StaticResource StatusSeverityConverter}}">
                        <TextBlock Style="{StaticResource StatusBadgeText}" Text="{Binding RefreshTokenStatus, Converter={StaticResource RtDisplayConverter}}" TextTrimming="CharacterEllipsis"/>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="2FA" Width="96" IsReadOnly="True" SortMemberPath="TwoFactorStatus" CanUserSort="True">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource StatusBadge}" Tag="{Binding TwoFactorStatus, Converter={StaticResource StatusSeverityConverter}}">
                        <TextBlock Style="{StaticResource StatusBadgeText}" Text="{Binding TwoFactorStatus}" TextTrimming="CharacterEllipsis"/>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Phương thức thanh toán &amp; Ưu đãi" Width="360" IsReadOnly="True" SortMemberPath="PromotionStatus" CanUserSort="True">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Grid VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding PaymentMethodBadges}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel VerticalAlignment="Center"/>
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Style="{StaticResource PaymentMethodBadge}">
                                <TextBlock Text="{Binding}" Style="{StaticResource PaymentMethodBadgeText}"/>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Tag="{Binding PromotionStatus, Converter={StaticResource StatusSeverityConverter}}">
                          <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StatusBadge}">
                              <Setter Property="Visibility" Value="Collapsed"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding PaymentMethodBadges.Count}" Value="0">
                                  <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <TextBlock Style="{StaticResource StatusBadgeText}" Text="{Binding PromotionStatus}" TextTrimming="CharacterEllipsis"/>
                        </Border>
                      </Grid>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Chi tiết" Width="80">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Height="24" Padding="6,0" Click="AccountDetail_Click" ToolTip="XemChi tiết">
                        <StackPanel Orientation="Horizontal">
                          <Path Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource TextSub}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                                Data="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/>
                          <TextBlock Text="Xem" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Border>

          <GridSplitter Grid.Row="4" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource SplitterBg}" ShowsPreview="True"/>

          <Grid Grid.Row="5" Margin="0,10,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="64" MinHeight="42"/>
              <RowDefinition Height="5"/>
              <RowDefinition Height="*" MinHeight="200"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Padding="0" CornerRadius="4" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
              <DataGrid x:Name="TaskGrid"
                        ItemsSource="{Binding Tasks}"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        Background="{DynamicResource PanelBg}"
                        Foreground="{DynamicResource TextMain}"
                        RowBackground="{DynamicResource PanelBg}"
                        AlternatingRowBackground="{DynamicResource GridAltBg}"
                        HorizontalGridLinesBrush="{DynamicResource Line}"
                        VerticalGridLinesBrush="Transparent"
                        RowStyle="{StaticResource {x:Type DataGridRow}}"
                        CellStyle="{StaticResource {x:Type DataGridCell}}"
                        ColumnHeaderStyle="{StaticResource {x:Type DataGridColumnHeader}}"
                        RowHeight="26"
                        BorderThickness="0"
ScrollViewer.HorizontalScrollBarVisibility="Auto"
ScrollViewer.VerticalScrollBarVisibility="Auto"
VirtualizingPanel.IsVirtualizing="True"
VirtualizingPanel.VirtualizationMode="Recycling"
Loaded="TaskGrid_Loaded">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Batch" Binding="{Binding Name}" Width="160"/>
                  <DataGridTextColumn Header="Tác vụ" Binding="{Binding Task}" Width="160"/>
                  <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="90"/>
                  <DataGridTextColumn Header="Tham số" Binding="{Binding Info}" Width="520"/>
                  <DataGridTextColumn Header="Thời gian (s)" Binding="{Binding Cost}" Width="80"/>
                  <DataGridTextColumn Header="Thời gian hoàn tất" Binding="{Binding DoneAt}" Width="150"/>
                </DataGrid.Columns>
              </DataGrid>
            </Border>
            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource SplitterBg}" ShowsPreview="True"/>
            <Border Grid.Row="2" Background="{DynamicResource LogBg}" BorderBrush="{DynamicResource LogBorder}" BorderThickness="1" CornerRadius="4">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button Grid.Row="0" Width="74" Height="26" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,4,8,2" Padding="8,0" Click="ClearLog_Click">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource IconPath}" Width="13" Height="13" StrokeThickness="1.7"
                          Data="M3.5 5H12.5 M6 5V3.5H10V5 M5 6.5V13H11V6.5 M7 8V11.5 M9 8V11.5"/>
                    <TextBlock Text="Xóa" Margin="6,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <TextBox Grid.Row="1" x:Name="LogTextBox" Text="{Binding LogText, Mode=OneWay}" Background="{DynamicResource LogBg}" Foreground="{DynamicResource LogText}" BorderThickness="0"
                         FontFamily="Consolas" FontSize="12" IsReadOnly="True" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         VerticalAlignment="Stretch" HorizontalAlignment="Stretch" MinHeight="220" Padding="8,8,8,8"/>
              </Grid>
            </Border>
          </Grid>

          <Border Grid.Row="6" Background="{DynamicResource StatusBg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <TextBlock Margin="8,3" Text="{Binding StatusText}" Foreground="{DynamicResource TextSub}"/>
          </Border>
        </Grid>
      </Grid>
    <ui:SnackbarPresenter x:Name="SnackbarPresenter" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24,24,24,48"/>
    </Grid>
</ui:FluentWindow>

<Window x:Class="SmsWorkbench.PaymentBatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trích xuất thanh toán giao thức hàng loạt"
        Width="1120"
        Height="900"
        MinWidth="920"
        MinHeight="760"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}">
  <Window.Resources>
    <SolidColorBrush x:Key="PaymentListBg" Color="#10151D"/>
    <SolidColorBrush x:Key="PaymentListRowBg" Color="#151A23"/>
    <SolidColorBrush x:Key="PaymentListRowHover" Color="#1B2230"/>
    <SolidColorBrush x:Key="PaymentListLine" Color="#263142"/>
    <SolidColorBrush x:Key="PaymentListText" Color="#F3F7FF"/>
    <SolidColorBrush x:Key="PaymentListMuted" Color="#8B97AA"/>

    <Style x:Key="PaymentResultItemContainer" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <ContentPresenter/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PaymentStatusBadge" TargetType="Border">
      <Setter Property="Width" Value="74"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="#112B24"/>
      <Setter Property="BorderBrush" Value="#00A674"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding ResultStatus}" Value="Đang chạy">
          <Setter Property="Background" Value="#10243A"/>
          <Setter Property="BorderBrush" Value="#2F80ED"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding ResultStatus}" Value="Thất bại">
          <Setter Property="Background" Value="#35171A"/>
          <Setter Property="BorderBrush" Value="#F05252"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding ResultStatus}" Value="Đang chờ">
          <Setter Property="Background" Value="#202633"/>
          <Setter Property="BorderBrush" Value="#64748B"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PaymentMethodBadge" TargetType="Border">
      <Setter Property="Height" Value="24"/>
      <Setter Property="MinWidth" Value="48"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Background" Value="#334155"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding}" Value="Trial: 0 đ">
          <Setter Property="Background" Value="#168A3A"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Card">
          <Setter Property="Background" Value="#6758E8"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Apple Pay">
          <Setter Property="Background" Value="#05070A"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Google Pay">
          <Setter Property="Background" Value="#F8FAFC"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="MoMo">
          <Setter Property="Background" Value="#C01886"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PaymentMethodBadgeText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding}" Value="Google Pay">
          <Setter Property="Foreground" Value="#1F2937"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
        <TextBlock Text="Trích xuất thanh toán giao thức hàng loạt" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="{Binding AccountSummary}" Foreground="{DynamicResource TextSub}" VerticalAlignment="Center"/>
    </Grid>

    <Grid Grid.Row="1" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Margin="0,0,7,10">
        <TextBlock Text="Phương thức thanh toán" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{Binding PaymentMethodOptions}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedMethod}"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="7,0,7,10">
        <TextBlock Text="Song song" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{Binding WorkerOptions}" SelectedItem="{Binding Workers}"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Margin="7,0,7,10">
        <TextBlock Text="Thử lại lỗi tạm thời" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{Binding RetryOptions}" SelectedItem="{Binding Retries}"/>
      </StackPanel>
      <StackPanel Grid.Column="3" Margin="7,0,0,10">
        <TextBlock Text="Số lượng canary (0=tất cả)" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding CanaryText, UpdateSourceTrigger=PropertyChanged}"/>
      </StackPanel>

      <!-- Batch mặc định tạo mới; bật khôi phục checkpoint để dùng lại ID nhập bên dưới. -->
      <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,7,10">
        <TextBlock Text="Pool proxy Checkout (host:port:user:password; hỗ trợ http/https/socks5/socks5h)" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
        <TextBox Text="{Binding CheckoutProxyPool, UpdateSourceTrigger=PropertyChanged}"
                 FontFamily="Consolas"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 Height="62"
                 VerticalScrollBarVisibility="Auto"/>
        <TextBlock Text="{Binding CheckoutRegionSummary, StringFormat=Thành phần pool: {0}}" Foreground="{DynamicResource TextSub}" FontSize="11" Margin="0,3,0,0"/>
      </StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="7,0,0,10">
        <TextBlock Text="Pool proxy Approve / Update (host:port:user:password; hỗ trợ http/https/socks5/socks5h)" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
        <TextBox Text="{Binding ApproveProxyPool, UpdateSourceTrigger=PropertyChanged}"
                 FontFamily="Consolas"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 Height="62"
                 VerticalScrollBarVisibility="Auto"/>
        <TextBlock Text="{Binding ApproveRegionSummary, StringFormat=Thành phần pool: {0}}" Foreground="{DynamicResource TextSub}" FontSize="11" Margin="0,3,0,0"/>
      </StackPanel>

      <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,7,10">
        <TextBlock Text="Quốc gia exit Checkout (mặc định theo vùng thanh toán)" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{Binding CheckoutCountryOptions}"
                  DisplayMemberPath="DisplayName"
                  SelectedValuePath="Code"
                  SelectedValue="{Binding CheckoutProxyCountry, UpdateSourceTrigger=PropertyChanged}"/>
      </StackPanel>
      <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Margin="7,0,0,10">
        <TextBlock Text="Quốc gia exit Approve / Update" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{Binding ApproveCountryOptions}"
                  DisplayMemberPath="DisplayName"
                  SelectedValuePath="Code"
                  SelectedValue="{Binding ApproveProxyCountry, UpdateSourceTrigger=PropertyChanged}"/>
      </StackPanel>

      <StackPanel Grid.Row="3" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,2">
        <CheckBox Content="Tự khôi phục 401 (RT/Cookie/OTP email/OAuth)" IsChecked="{Binding JitRefresh}" Margin="0,0,22,0"/>
        <CheckBox Content="Chỉ kiểm tra khả năng (Checkout + Stripe init)" IsChecked="{Binding ProbeOnly}" Margin="0,0,22,0"/>
        <CheckBox Content="Yêu cầu số tiền 0" IsChecked="{Binding RequireZero}" IsEnabled="{Binding RequireZeroEnabled}"/>
        <CheckBox Content="Khôi phục checkpoint hiện có" IsChecked="{Binding ResumeCheckpoint}" Margin="22,0,0,0"/>
        <TextBlock Text="{Binding ExecutionModeSummary}" Foreground="{DynamicResource TextSub}" VerticalAlignment="Center" Margin="10,0,0,0"/>
      </StackPanel>

      <StackPanel Grid.Row="4" Grid.ColumnSpan="4" Margin="0,0,0,10">
        <TextBlock Text="Khi chưa chọn email, có thể nhập Access Token (mỗi dòng một token, tối đa 10)" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding ManualAccessTokens, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 Height="72"
                 FontFamily="Consolas"
                 VerticalScrollBarVisibility="Auto"
                 ToolTip="Mỗi dòng một JWT Access Token; khi đã chọn email, mục này không tham gia tác vụ"/>
      </StackPanel>
      <StackPanel Grid.Row="5" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,0,0,10">
        <TextBlock Text="ID batch" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBox Text="{Binding BatchId, UpdateSourceTrigger=PropertyChanged}" Width="300" FontFamily="Consolas"/>
        <TextBlock Text="Chỉ dùng lại ID này khi bật &quot;Khôi phục checkpoint hiện có&quot;" Foreground="{DynamicResource TextSub}" VerticalAlignment="Center" Margin="12,0,0,0"/>
      </StackPanel>
    </Grid>

    <!-- Khu vực tài khoản / ma trận đủ điều kiện thanh toán đã được gỡ; mọi tài khoản dùng khu vực proxy đã cấu hình ở trên. -->

    <Border Grid.Row="2"
            Margin="0,0,0,12"
            Background="{StaticResource PaymentListBg}"
            BorderBrush="{StaticResource PaymentListLine}"
            BorderThickness="1"
            CornerRadius="6">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="14,10,14,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="42"/>
            <ColumnDefinition Width="92"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="92"/>
            <ColumnDefinition Width="76"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="#" Foreground="{StaticResource PaymentListMuted}" FontFamily="Consolas"/>
          <TextBlock Grid.Column="1" Text="Kết quả" Foreground="{StaticResource PaymentListMuted}" FontWeight="SemiBold"/>
          <TextBlock Grid.Column="2" Text="Tài khoản / ưu đãi / phương thức" Foreground="{StaticResource PaymentListMuted}" FontWeight="SemiBold"/>
          <TextBlock Grid.Column="3" Text="Thời gian" Foreground="{StaticResource PaymentListMuted}" FontWeight="SemiBold"/>
          <TextBlock Grid.Column="4" Text="Thao tác" Foreground="{StaticResource PaymentListMuted}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
        </Grid>
        <ListBox x:Name="ResultsGrid"
                 Grid.Row="1"
                 ItemsSource="{Binding Results}"
                 ItemContainerStyle="{StaticResource PaymentResultItemContainer}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Margin="10,0,10,8"
                      Padding="12,10"
                      MinHeight="76"
                      Background="{StaticResource PaymentListRowBg}"
                      BorderBrush="{StaticResource PaymentListLine}"
                      BorderThickness="0,0,0,1"
                      CornerRadius="5">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="76"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding RowNumber}"
                             Foreground="{StaticResource PaymentListMuted}"
                             FontFamily="Consolas"
                             VerticalAlignment="Center"/>
                  <Border Grid.Column="1"
                          Style="{StaticResource PaymentStatusBadge}"
                          VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusBadgeText}"
                               Foreground="#F8FAFC"
                               FontFamily="Consolas"
                               FontSize="11"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AccountRef}"
                               Foreground="{StaticResource PaymentListText}"
                               FontFamily="Consolas"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding AccountRef}"/>
                    <Grid Margin="0,8,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <ItemsControl ItemsSource="{Binding MethodBadges}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel/>
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Style="{StaticResource PaymentMethodBadge}">
                              <TextBlock Text="{Binding}" Style="{StaticResource PaymentMethodBadgeText}"/>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Grid.Column="1"
                                 Text="{Binding ResultDisplay}"
                                 Foreground="{StaticResource PaymentListMuted}"
                                 FontFamily="Consolas"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip="{Binding ResultDisplay}"
                                 VerticalAlignment="Center"/>
                    </Grid>
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ProgressPercent}"
                                 Height="4"
                                 Margin="0,8,18,0"
                                 Background="#0B1018"
                                 Foreground="#64748B"/>
                  </StackPanel>
                  <TextBlock Grid.Column="3"
                             Text="{Binding ElapsedText}"
                             Foreground="{StaticResource PaymentListMuted}"
                             FontFamily="Consolas"
                             VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="4"
                              Orientation="Horizontal"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center">
                    <Button Width="32"
                            Height="32"
                            Padding="0"
                            Margin="0,0,6,0"
                            Background="#0B1018"
                            BorderBrush="{StaticResource PaymentListLine}"
                            Command="{Binding DataContext.CopyResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            IsEnabled="{Binding HasCopyableResult}"
                            ToolTip="{Binding CopyToolTip}">
                      <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#CBD5E1"/>
                    </Button>
                    <Border Width="32"
                            Height="32"
                            CornerRadius="4"
                            Background="#0B1018"
                            BorderBrush="{StaticResource PaymentListLine}"
                            BorderThickness="1"
                            ToolTip="{Binding CurrentStage}">
                      <TextBlock Text="&#xE10A;"
                                 FontFamily="Segoe MDL2 Assets"
                                 FontSize="11"
                                 Foreground="#94A3B8"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Border>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextSub}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="Kiểm tra proxy" Command="{Binding TestProxiesCommand}" MinWidth="84" Margin="0,0,8,0"/>
        <Button Content="Lưu cấu hình proxy" Command="{Binding SaveProxyConfigurationCommand}" MinWidth="108" Margin="0,0,8,0"/>
        <Button Content="Mở báo cáo" Command="{Binding OpenReportCommand}" MinWidth="84" Margin="0,0,8,0"/>
        <Button Content="Hủy" Command="{Binding RunCancelCommand}" MinWidth="72" Margin="0,0,8,0"/>
        <Button Content="Bắt đầu chạy" Command="{Binding RunCommand}" MinWidth="96" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
        <Button Content="Đóng" MinWidth="72" IsCancel="True"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
